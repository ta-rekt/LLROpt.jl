        RowBox[{"(*", 
         RowBox[{"non", "-", 
          RowBox[{"absorbing", " ", "set"}]}], "*)"}], 
        RowBox[{"m", "=", 
         RowBox[{"Length", "[", "subStates", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"results", "=", 
