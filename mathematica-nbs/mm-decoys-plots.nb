          RowBox[{"MemberQ", "[", 
           RowBox[{"hit", ",", "start"}], "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "Then", " ", "we", " ", "trivially", " ", "return", " ", "a", " ",
              "vector", " ", "of", " ", "dimension", " ", 
             RowBox[{"Length", "[", "hit", "]"}]}], ",", 
            RowBox[{"where", " ", "the", " ", "entry", " ", 
             RowBox[{"for", "'"}], 
             RowBox[{"start", "'"}], " ", "is", " ", "1"}], ",", 
