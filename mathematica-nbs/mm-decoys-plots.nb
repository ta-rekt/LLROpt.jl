                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"subStates", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "hj"}], "]"}], 
                  "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "1", ",", "m"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"Solve", " ", "and", " ", "get", " ", 
