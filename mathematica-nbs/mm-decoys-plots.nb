           RowBox[{"state", ".", 
            RowBox[{"We", "'"}]}], "ll", " ", "handle", " ", "it", " ", 
           RowBox[{"below", "."}]}]}]}], "*)"}], 
       RowBox[{
        RowBox[{"If", "[", 
