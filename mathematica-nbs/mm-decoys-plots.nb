Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Joint", " ", "Fisher", " ", "information", " ", "rate"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"k", " ", "=", " ", "15"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cvals", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"10.", "^", "x"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "3", ",", "k"}], "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wvals", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"10.", "^", "x"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "2", ",", "k"}], "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"data", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Log", "[", 
        RowBox[{
         RowBox[{"results", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "j"}], "]"}], "]"}], "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "k"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "k"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"fig1", " ", "=", " ", 
    RowBox[{"With", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"g", " ", "=", " ", 
        RowBox[{
         RowBox[{"GrayLevel", "[", 
          RowBox[{"1", "-", "#"}], "]"}], " ", "&"}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"ListDensityPlot", "[", 
       RowBox[{
        RowBox[{"data", "\[Transpose]"}], ",", "\[IndentingNewLine]", 
        RowBox[{"InterpolationOrder", "->", "0"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"Controls", " ", 
            RowBox[{"smoothing", ":", "0"}]}], "=", "none"}], ",", 
          RowBox[{
           RowBox[{"higher", " ", "values"}], "=", 
           RowBox[{"smoother", " ", "interpolation"}]}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"ColorFunction", "->", "g"}], ",", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
           RowBox[{"Choose", " ", "a", " ", "color", " ", "gradient"}], ";", 
           RowBox[{
           "alternatives", " ", "include", " ", "\"\<TemperatureMap\>\""}]}], 
          ",", "\"\<Rainbow\>\"", ",", 
          RowBox[{"etc", "."}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"Frame", "->", "True"}], ",", 
        RowBox[{"(*", 
         RowBox[{
         "Use", " ", "a", " ", "framed", " ", "plot", " ", "to", " ", 
          "enable", " ", "axis", " ", "labels"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          
          RowBox[{"\"\<log(\!\(\*SubscriptBox[\(c\), \(0\)]\))\>\"", 
           ",", "\"\<log(\[Omega])\>\""}], "}"}]}], ",", 
        RowBox[{"(*", 
         RowBox[{"Label", " ", "your", " ", "axes"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"LabelStyle", "->", "13"}], ",", "\[IndentingNewLine]", 
        RowBox[{"FrameTicks", "->", 
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"Round", "[", 
                  RowBox[{
                   RowBox[{"Log10", "[", 
                    RowBox[{"wvals", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "0.1"}], 
                  "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "k", ",", "3"}], "}"}]}], "]"}], ",",
              "Automatic"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"i", ",", 
                 RowBox[{"Round", "[", 
                  RowBox[{
                   RowBox[{"Log10", "[", 
                    RowBox[{"cvals", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], "]"}], ",", "0.1"}], 
                  "]"}]}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "k", ",", "3"}], "}"}]}], "]"}], ",",
              "Automatic"}], "}"}]}], "\[IndentingNewLine]", "}"}]}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"ScalingFunctions", "->", 
           RowBox[{"{", "\"\<Log\>\"", "}"}]}], ","}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"BarLegend", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"g", ",", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"Min", "[", "data", "]"}], ",", 
               RowBox[{"Max", "[", "data", "]"}]}], "}"}]}], "}"}], ",", 
           RowBox[{"LegendLabel", "->", 
            RowBox[{"Placed", "[", 
             
             RowBox[{"\"\<\!\(\*OverscriptBox[\(F\), \(.\)]\)\>\"", ",", 
              "Right"}], "]"}]}], ",", 
           RowBox[{"LegendMarkerSize", "->", "200"}]}], "]"}]}], ",", 
        RowBox[{"(*", 
         RowBox[{
         "Add", " ", "a", " ", "colorbar", " ", "that", " ", "matches", " ", 
          "the", " ", "ColorFunction"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"ImageSize", "->", "250"}]}], "\[IndentingNewLine]", "]"}]}], 
     "]"}]}]}]}]], "Input",
