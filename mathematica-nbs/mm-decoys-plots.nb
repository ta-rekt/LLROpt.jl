           RowBox[{"state", ".", 
            RowBox[{"We", "'"}]}], "ll", " ", "handle", " ", "it", " ", 
           RowBox[{"below", "."}]}]}]}], "*)"}], 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"hit", ",", "start"}], "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "Then", " ", "we", " ", "trivially", " ", "return", " ", "a", " ",
              "vector", " ", "of", " ", "dimension", " ", 
             RowBox[{"Length", "[", "hit", "]"}]}], ",", 
            RowBox[{"where", " ", "the", " ", "entry", " ", 
             RowBox[{"for", "'"}], 
             RowBox[{"start", "'"}], " ", "is", " ", "1"}], ",", 
            RowBox[{"and", " ", "all", " ", "others", " ", "0."}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", 
           RowBox[{"Map", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{"#", "==", "start"}], ",", "1", ",", "0"}], "]"}], 
              "&"}], ",", "hit"}], "]"}], "]"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Otherwise", ",", 
          RowBox[{
          "we", " ", "solve", " ", "one", " ", "linear", " ", "system", " ", 
           "for", " ", "each", " ", "h_j", " ", 
           RowBox[{"in", "'"}], 
           RowBox[{
            RowBox[{"hit", "'"}], "."}]}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"subStates", "=", 
         RowBox[{"Complement", "[", 
          RowBox[{
           RowBox[{"Range", "[", "n", "]"}], ",", "hit"}], "]"}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"non", "-", 
          RowBox[{"absorbing", " ", "set"}]}], "*)"}], 
        RowBox[{"m", "=", 
         RowBox[{"Length", "[", "subStates", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"results", "=", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Build", " ", "the", " ", 
               RowBox[{"(", 
                RowBox[{"Q", "-", "sI"}], ")"}], " ", "submatrix", " ", "for",
                " ", "non"}], "-", 
              RowBox[{"absorbing", " ", 
               RowBox[{"states", "."}]}]}], "*)"}], 
            RowBox[{
             RowBox[{"eqMatrix", "=", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"Q", "[", 
                 RowBox[{"[", 
                  RowBox[{
                   RowBox[{"subStates", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                   RowBox[{"subStates", "[", 
                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "m"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "m"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Do", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"eqMatrix", "[", 
                 RowBox[{"[", 
                  RowBox[{"i", ",", "i"}], "]"}], "]"}], "-=", "s"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "1", ",", "m"}], "}"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"RHS", "=", 
                RowBox[{
                 RowBox[{"-", "Q_"}], 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "h_j"}], "}"}]}]}], ",", 
               RowBox[{"for", " ", "each", " ", "i", " ", "in", " ", 
                RowBox[{"subStates", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
             RowBox[{"eqRHS", "=", 
              RowBox[{"Table", "[", 
               RowBox[{
                RowBox[{"-", 
                 RowBox[{"Q", "[", 
                  RowBox[{"[", 
                   RowBox[{
                    RowBox[{"subStates", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", "hj"}], "]"}], 
                  "]"}]}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "1", ",", "m"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{"Solve", " ", "and", " ", "get", " ", 
               RowBox[{"phi_i", "^", 
                RowBox[{"(", "j", ")"}]}], 
               RowBox[{
                RowBox[{"(", "s", ")"}], ".", "Then"}], " ", "extract", " ", 
               RowBox[{"the", "'"}], 
               RowBox[{"start", "'"}], " ", 
               RowBox[{"component", "."}]}], "*)"}], "\[IndentingNewLine]", 
             RowBox[{"sol", "=", 
              RowBox[{"LinearSolve", "[", 
               RowBox[{"eqMatrix", ",", "eqRHS"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"iPos", "=", 
              RowBox[{"First", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"subStates", ",", "start"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"sol", "[", 
              RowBox[{"[", "iPos", "]"}], "]"}]}], ")"}], ",", 
           RowBox[{"{", 
            RowBox[{"hj", ",", "hit"}], "}"}]}], "  ", 
          RowBox[{"(*", 
           RowBox[{"for", " ", "each", " ", "absorbing", " ", "state", " ", 
            RowBox[{"in", "'"}], 
            RowBox[{"hit", "'"}]}], "*)"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "results", "]"}], ";"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]"}]}]], "Input",
