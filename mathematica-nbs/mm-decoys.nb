   RowBox[{
    RowBox[{
     RowBox[{"dcHatOnNum", "[", 
      RowBox[{
      "c_", ",", "\[Omega]_", ",", "\[Gamma]_", ",", "kboff_", ",", "konb_", ",",
        "kuon_", ",", "kbon_", ",", "koffu_", ",", "kuoff_", ",", "konu_", ",",
        "sampleTon_"}], "]"}], ":=", " ", 
     RowBox[{"Evaluate", "[", "dcHatOnSym", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cHatOffNum", "[", 
      RowBox[{
      "c_", ",", "\[Omega]_", ",", "\[Gamma]_", ",", "kboff_", ",", "konb_", ",",
        "kuon_", ",", "kbon_", ",", "koffu_", ",", "kuoff_", ",", "konu_", ",",
        "sampleToff_"}], "]"}], ":=", " ", 
     RowBox[{"Evaluate", "[", "cHatOffSym", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"cHatOnNum", "[", 
      RowBox[{
      "c_", ",", "\[Omega]_", ",", "\[Gamma]_", ",", "kboff_", ",", "konb_", ",",
        "kuon_", ",", "kbon_", ",", "koffu_", ",", "kuoff_", ",", "konu_", ",",
        "sampleTon_"}], "]"}], ":=", " ", 
     RowBox[{"Evaluate", "[", "cHatOnSym", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Numeric", " ", "function", " ", "for", " ", "Fisher", " ", "info", " ", 
     "rate"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Fnum", "[", 
     RowBox[{
      RowBox[{"c_", "?", "NumericQ"}], ",", 
      RowBox[{"\[Omega]_", "?", "NumericQ"}], ",", 
      RowBox[{"\[Gamma]_", "?", "NumericQ"}], ",", 
      RowBox[{"kboff_", "?", "NumericQ"}], ",", 
      RowBox[{"konb_", "?", "NumericQ"}], ",", 
      RowBox[{"kuon_", "?", "NumericQ"}], ",", 
      RowBox[{"kbon_", "?", "NumericQ"}], ",", 
      RowBox[{"koffu_", "?", "NumericQ"}], ",", 
      RowBox[{"kuoff_", "?", "NumericQ"}], ",", 
      RowBox[{"konu_", "?", "NumericQ"}]}], "]"}], " ", ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "meanTon", ",", " ", "meanToff", ",", " ", "varTon", ",", " ", 
        "varToff", ",", " ", "covTonToff", ",", "dcHatOn", ",", "dcHatOff", ",",
         "delf", ",", "\[CapitalSigma]x", ",", "\[CapitalSigma]y", ",", 
        "\[Tau]", ",", "\[Sigma]2off", ",", "\[Sigma]2on", ",", "\[Sigma]2", ",",
         "Cov", ",", "cHat", ",", "Foff", ",", "Fon", ",", "F"}], "}"}], ",", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Numerical", " ", "values", " ", "for", " ", "mean"}], ",", 
        " ", 
        RowBox[{
        "variance", " ", "and", " ", "cov", " ", "of", " ", "FPTs"}]}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"meanTon", " ", "=", " ", 
         RowBox[{"meanTonNum", "[", 
          RowBox[{
          "c", ",", "\[Omega]", ",", "\[Gamma]", ",", "kboff", ",", "konb", ",",
            "kuon", ",", "kbon", ",", "koffu", ",", "kuoff", ",", "konu"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"meanToff", " ", "=", " ", 
         RowBox[{"meanToffNum", "[", 
          RowBox[{
          "c", ",", "\[Omega]", ",", "\[Gamma]", ",", "kboff", ",", "konb", ",",
            "kuon", ",", "kbon", ",", "koffu", ",", "kuoff", ",", "konu"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"varTon", " ", "=", " ", 
         RowBox[{"varTonNum", "[", 
          RowBox[{
          "c", ",", "\[Omega]", ",", "\[Gamma]", ",", "kboff", ",", "konb", ",",
            "kuon", ",", "kbon", ",", "koffu", ",", "kuoff", ",", "konu"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"varToff", " ", "=", " ", 
         RowBox[{"varToffNum", "[", 
          RowBox[{
          "c", ",", "\[Omega]", ",", "\[Gamma]", ",", "kboff", ",", "konb", ",",
            "kuon", ",", "kbon", ",", "koffu", ",", "kuoff", ",", "konu"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"covTonToff", " ", "=", " ", 
         RowBox[{"covTonToffNum", "[", 
          RowBox[{
          "c", ",", "\[Omega]", ",", "\[Gamma]", ",", "kboff", ",", "konb", ",",
            "kuon", ",", "kbon", ",", "koffu", ",", "kuoff", ",", "konu"}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"\[Tau]", " ", "=", " ", 
         RowBox[{"meanTon", " ", "+", " ", "meanToff"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"\[CapitalSigma]x", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"varToff", ",", "covTonToff"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"covTonToff", ",", "varTon"}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", "Jacobian", "*)"}], "\[IndentingNewLine]", 
        RowBox[{"dcHatOff", "=", 
         RowBox[{"dcHatOffNum", "[", 
          RowBox[{
          "c", ",", "\[Omega]", ",", "\[Gamma]", ",", "kboff", ",", "konb", ",",
            "kuon", ",", "kbon", ",", "koffu", ",", "kuoff", ",", "konu", ",",
            "meanToff"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"dcHatOn", "=", 
         RowBox[{"dcHatOnNum", "[", 
          RowBox[{
          "c", ",", "\[Omega]", ",", "\[Gamma]", ",", "kboff", ",", "konb", ",",
            "kuon", ",", "kbon", ",", "koffu", ",", "kuoff", ",", "konu", ",",
            "meanTon"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"delf", " ", "=", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"dcHatOff", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", "dcHatOn"}], " ", "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"Covariance", " ", "matrix", " ", "of", " ", "estimators"}], 
         "*)"}], "\[IndentingNewLine]", 
        RowBox[{"\[CapitalSigma]y", " ", "=", " ", 
         RowBox[{
          RowBox[{"delf", "\[Transpose]"}], ".", "\[CapitalSigma]x", ".", 
          "delf"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "Combined", " ", "estimator", " ", "and", " ", "its", " ", 
          "variance"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"\[Sigma]2off", " ", "=", " ", 
         RowBox[{"\[CapitalSigma]y", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"\[Sigma]2on", " ", "=", " ", 
         RowBox[{"\[CapitalSigma]y", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Cov", " ", "=", " ", 
