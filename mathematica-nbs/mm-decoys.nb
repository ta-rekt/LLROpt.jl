Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Combined", " ", "estimator", " ", "and", " ", "its", " ", "variance"}], 
   "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Sigma]2off", " ", "=", " ", 
     RowBox[{"\[CapitalSigma]y", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"\[Sigma]2on", " ", "=", " ", 
     RowBox[{"\[CapitalSigma]y", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Cov", " ", "=", " ", 
     RowBox[{"\[CapitalSigma]y", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"\[Rho]", " ", "=", " ", 
     RowBox[{"Cov", "/", 
      RowBox[{"(", 
       RowBox[{"\[Sigma]2off", "*", "\[Sigma]2on"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cHat", " ", "=", " ", 
     FractionBox[
      RowBox[{
       RowBox[{"cHatOffSym", "*", 
        RowBox[{"(", 
         RowBox[{"\[Sigma]2on", "-", "Cov"}], ")"}]}], " ", "+", " ", 
       RowBox[{"cHatOnSym", "*", 
        RowBox[{"(", 
         RowBox[{"\[Sigma]2off", "-", "Cov"}], ")"}]}]}], 
      RowBox[{"\[Sigma]2off", " ", "+", " ", "\[Sigma]2on", " ", "-", " ", 
       RowBox[{"2", "Cov"}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Sigma]2", " ", "=", " ", 
     FractionBox[
      RowBox[{
       RowBox[{"\[Sigma]2on", "*", "\[Sigma]2off"}], " ", "-", " ", 
       SuperscriptBox["Cov", "2"]}], 
      RowBox[{"\[Sigma]2off", " ", "+", " ", "\[Sigma]2on", " ", "-", " ", 
       RowBox[{"2", "Cov"}]}]]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Concentration", "-", 
     RowBox[{"rescaled", " ", "Fisher", " ", "information", " ", "rates"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Foff", " ", "=", " ", 
     RowBox[{
      SuperscriptBox["c", "2"], "/", " ", 
      RowBox[{"(", 
       RowBox[{"\[Tau]", "*", "\[Sigma]2off", "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Rho]"}], ")"}], "2"]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Fon", " ", "=", " ", 
     RowBox[{
      SuperscriptBox["c", "2"], "/", " ", 
      RowBox[{"(", 
       RowBox[{"\[Tau]", "*", "\[Sigma]2on", "*", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "\[Rho]"}], ")"}], "2"]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Fcross", " ", "=", " ", 
     RowBox[{
      RowBox[{"-", "2"}], "*", 
      SuperscriptBox["c", "2"], "*", 
      RowBox[{"\[Rho]", "/", 
       RowBox[{"(", 
        RowBox[{"\[Tau]", "*", 
