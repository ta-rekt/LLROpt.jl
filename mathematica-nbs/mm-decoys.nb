          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"cHat", " ", "=", " ", 
         FractionBox[
          RowBox[{
           RowBox[{"cHatOff", "*", 
            RowBox[{"(", 
             RowBox[{"\[Sigma]2on", "-", "Cov"}], ")"}]}], " ", "+", " ", 
           RowBox[{"cHatOn", "*", 
            RowBox[{"(", 
             RowBox[{"\[Sigma]2off", "-", "Cov"}], ")"}]}]}], 
          RowBox[{"\[Sigma]2off", " ", "+", " ", "\[Sigma]2on", " ", "-", " ", 
           RowBox[{"2", "Cov"}]}]]}], "*)"}], ";", "\[IndentingNewLine]", 
       RowBox[{"\[Sigma]2", " ", "=", " ", 
        FractionBox[
         RowBox[{
          RowBox[{"\[Sigma]2on", "*", "\[Sigma]2off"}], " ", "-", " ", 
          SuperscriptBox["Cov", "2"]}], 
         RowBox[{
         "\[Sigma]2off", " ", "+", " ", "\[Sigma]2on", " ", "-", " ", 
          RowBox[{"2", "Cov"}]}]]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Concentration", "-", 
         RowBox[{
         "rescaled", " ", "Fisher", " ", "information", " ", "rates"}]}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Foff", " ", "=", " ", 
          RowBox[{
           SuperscriptBox["c", "2"], "/", " ", 
           RowBox[{"(", 
            RowBox[{"\[Tau]", "*", "\[Sigma]2off"}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"Fon", " ", "=", " ", 
          RowBox[{
           SuperscriptBox["c", "2"], "/", " ", 
           RowBox[{"(", 
            RowBox[{"\[Tau]", "*", "\[Sigma]2on"}], ")"}]}]}], ";"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"F", " ", "=", " ", 
        RowBox[{
         SuperscriptBox["c", "2"], "/", " ", 
         RowBox[{"(", 
          RowBox[{"\[Tau]", "*", "\[Sigma]2"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "F", "]"}]}]}], "]"}]}]}]}]], "Input",
