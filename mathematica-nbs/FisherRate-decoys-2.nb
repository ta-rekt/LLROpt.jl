           RowBox[{"w2", ",", 
            RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"Method", "->", 
           RowBox[{"OptionValue", "[", "Method", "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"MaxRecursion", "->", 
