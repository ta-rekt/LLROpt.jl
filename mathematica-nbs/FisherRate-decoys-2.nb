        RowBox[{"t1", ",", "t2"}], ")"}], " ", "via", " ", "the", " ", 
       "double", " ", "Bromwich", " ", "integral", " ", "f", 
       RowBox[{"(", 
        RowBox[{"t1", ",", "t2"}], ")"}]}]}], "=", 
     RowBox[{
      RowBox[{
       RowBox[{"1", "/", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"2", "\[Pi]i"}], ")"}], "^", "2"}]}], " ", 
       RowBox[{"\[Integral]", 
        RowBox[{"_", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Re", " ", "s1"}], "=", "c1"}], "}"}], " ", 
         RowBox[{"\[Integral]", 
          RowBox[{"_", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Re", " ", "s2"}], "=", "c2"}], "}"}], " ", 
           RowBox[{"e", "^", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"s1", " ", "t1"}], "+", 
              RowBox[{"s2", " ", "t2"}]}], "}"}]}], " ", "F", 
           RowBox[{"(", 
            RowBox[{"s1", ",", "s2"}], ")"}], " ", "ds2", " ", "ds1", " ", 
           RowBox[{"Usage", ":", 
            RowBox[{
             RowBox[{"InverseLaplace2D", "[", 
              RowBox[{"F", ",", "t1", ",", "t2"}], "]"}], " ", "uses", " ", 
             "defaults", " ", "c1"}]}]}]}]}]}]}], "=", 
      RowBox[{"c2", "=", 
       RowBox[{"1.0", " ", 
        RowBox[{"InverseLaplace2D", "[", 
         RowBox[{"F", ",", "t1", ",", "t2", ",", "c1", ",", "c2"}], "]"}], " ",
         "specify", " ", "your", " ", "shifts", " ", "c1"}]}]}]}], ",", 
    RowBox[{"c2", " ", 
     RowBox[{"InverseLaplace2D", "[", 
      RowBox[{"...", ",", "opts"}], "]"}], " ", "extra", " ", "options", " ", 
     "passed", " ", "to", " ", "NIntegrate", " ", 
     RowBox[{"Note", ":", "c1"}]}], ",", 
    RowBox[{
    "c2", " ", "must", " ", "exceed", " ", "the", " ", "real", " ", "parts", " ",
      "of", " ", "all", " ", "singularities", " ", "of", " ", 
     RowBox[{"F", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "InverseLaplace2D", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Options", "[", "InverseLaplace2D", "]"}], "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Method", "->", 
        RowBox[{"{", "\"\<DoubleExponential\>\"", "}"}]}], ",", 
       RowBox[{"MaxRecursion", "->", "6"}], ",", 
       RowBox[{"PrecisionGoal", "->", "6"}]}], "}"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"InverseLaplace2D", "[", "\[IndentingNewLine]", 
      RowBox[{"Ffunc_", ",", "\[IndentingNewLine]", 
       RowBox[{"t1_", "?", "NumericQ"}], ",", 
       RowBox[{"t2_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
       RowBox[{"c1_", "?", 
        RowBox[{"NumericQ", ":", "1.0"}]}], ",", 
       RowBox[{"c2_", "?", 
        RowBox[{"NumericQ", ":", "1.0"}]}], ",", "\[IndentingNewLine]", 
       RowBox[{"opts", ":", 
        RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"w1", ",", "w2"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"(", 
          RowBox[{"4", " ", 
           RowBox[{"Pi", "^", "2"}]}], ")"}]}], "*", "\[IndentingNewLine]", 
        RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"Exp", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"c1", "+", 
                RowBox[{"I", " ", "w1"}]}], ")"}], " ", "t1"}], "+", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"c2", "+", 
                RowBox[{"I", " ", "w2"}]}], ")"}], " ", "t2"}]}], "]"}], "*", 
           "\[IndentingNewLine]", 
           RowBox[{"Ffunc", "[", 
            RowBox[{
             RowBox[{"c1", "+", 
              RowBox[{"I", " ", "w1"}]}], ",", 
             RowBox[{"c2", "+", 
              RowBox[{"I", " ", "w2"}]}]}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"w1", ",", 
            RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
