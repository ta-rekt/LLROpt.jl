       RowBox[{"f", 
        RowBox[{"(", 
         RowBox[{"t1", ",", "t2"}], ")"}]}]}], "=", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "a"}], " ", "t1"}], "-", 
        RowBox[{"b", " ", "t2"}]}], "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"a", "=", "1.0"}], ";", 
    RowBox[{"b", "=", "2.0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"F2", "[", 
