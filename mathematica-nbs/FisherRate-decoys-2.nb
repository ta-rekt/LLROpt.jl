       RowBox[{"f", 
        RowBox[{"(", 
         RowBox[{"t1", ",", "t2"}], ")"}]}]}], "=", "1"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"F1", "[", 
      RowBox[{"s1_", ",", "s2_"}], "]"}], ":=", 
