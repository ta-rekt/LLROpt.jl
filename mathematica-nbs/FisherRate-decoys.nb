       RowBox[{"c0i_", "?", "NumericQ"}], ",", 
       RowBox[{"c2i_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Gamma]i_", "?", "NumericQ"}], ",", 
       RowBox[{"kboffi_", "?", "NumericQ"}], ",", 
       RowBox[{"konbi_", "?", "NumericQ"}], ",", 
