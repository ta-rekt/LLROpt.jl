       RowBox[{"kuoffi_", "?", "NumericQ"}], ",", 
       RowBox[{"konui_", "?", "NumericQ"}]}], " ", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[Tau]PartialEval", ",", "integral"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"\[Tau]PartialEval", "=", 
         RowBox[{"\[Tau]Num", "[", 
          RowBox[{
          "c0i", ",", "c2i", ",", "\[Gamma]i", ",", "kboffi", ",", "konbi", ",",
            "kuoni", ",", "kboni", ",", "koffui", ",", "kuoffi", ",", 
           "konui"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"integral", "=", 
         RowBox[{"-", 
          RowBox[{"NIntegrate", "[", 
           RowBox[{
            RowBox[{"integrandCNum", "[", 
             RowBox[{
             "c0i", ",", "c2i", ",", "t1", ",", "t2", ",", "kboffi", ",", 
              "konbi", ",", "kuoni", ",", "kboni", ",", "koffui", ",", 
              "kuoffi", ",", "konui"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t1", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"t2", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Method", "->", 
             RowBox[{"{", 
              RowBox[{"\"\<DoubleExponential\>\"", ",", 
               RowBox[{"\"\<SymbolicProcessing\>\"", "->", "0"}]}], "}"}]}], ",",
             " ", "\[IndentingNewLine]", 
            RowBox[{"PrecisionGoal", "->", "6"}], ",", "\[IndentingNewLine]", 
            
            RowBox[{"AccuracyGoal", "->", "6"}], ",", "\[IndentingNewLine]", 
            RowBox[{"MinRecursion", "->", "3"}], ",", "\[IndentingNewLine]", 
            RowBox[{"MaxRecursion", "->", "6"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"integral", "*", 
         RowBox[{
          RowBox[{"c0i", "^", "2"}], "/", "\[Tau]PartialEval"}]}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FisherSafe", "[", 
      RowBox[{"pars__", "?", "NumericQ"}], "]"}], ":=", "\[IndentingNewLine]", 
     RowBox[{"Quiet", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Check", "[", "\[IndentingNewLine]", 
        RowBox[{
