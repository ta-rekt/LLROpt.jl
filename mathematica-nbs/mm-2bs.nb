  RowBox[{
   RowBox[{
    RowBox[{"\[Sigma]2off", " ", "=", " ", 
     RowBox[{"\[CapitalSigma]y", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"\[Sigma]2on", " ", "=", " ", 
     RowBox[{"\[CapitalSigma]y", "[", 
      RowBox[{"[", 
       RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   
   RowBox[{
    RowBox[{"Cov", " ", "=", " ", 
     RowBox[{"\[CapitalSigma]y", "[", 
      RowBox[{"[", 
       RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cHat", " ", "=", " ", 
     FractionBox[
      RowBox[{
       RowBox[{"cHatOffSym", "*", 
        RowBox[{"(", 
         RowBox[{"\[Sigma]2on", "-", "Cov"}], ")"}]}], " ", "+", " ", 
       RowBox[{"cHatOnSym", "*", 
        RowBox[{"(", 
         RowBox[{"\[Sigma]2off", "-", "Cov"}], ")"}]}]}], 
      RowBox[{"\[Sigma]2off", " ", "+", " ", "\[Sigma]2on", " ", "-", " ", 
       RowBox[{"2", "Cov"}]}]]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"\[Sigma]2", " ", "=", " ", 
     FractionBox[
      RowBox[{
       RowBox[{"\[Sigma]2on", "*", "\[Sigma]2off"}], " ", "-", " ", 
       SuperscriptBox["Cov", "2"]}], 
      RowBox[{"\[Sigma]2off", " ", "+", " ", "\[Sigma]2on", " ", "-", " ", 
       RowBox[{"2", "Cov"}]}]]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
