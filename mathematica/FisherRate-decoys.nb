Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "Maximize", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"nhours", "=", "7"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nmins", "=", 
     RowBox[{"60", "*", "nhours"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nseconds", "=", 
     RowBox[{"60", "*", 
      RowBox[{"nmins", "/", "3"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"because", " ", 
     RowBox[{"we", "'"}], "re", " ", "running", " ", "3", " ", 
     RowBox[{"params", "/", "kernel"}]}], "*)"}], "\[IndentingNewLine]", 
   "Now", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ParallelDo", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"results", "=", 
        RowBox[{"Reap", "[", "\[IndentingNewLine]", 
         RowBox[{"Catch", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"TimeConstrained", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"NMaximize", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"FisherSafe", "[", 
                  RowBox[{
                   RowBox[{"cvals", "[", 
                    RowBox[{"[", "i", "]"}], "]"}], ",", 
                   RowBox[{"\[Omega]", "*", 
                    RowBox[{"cvals", "[", 
                    RowBox[{"[", "i", "]"}], "]"}]}], ",", "\[Gamma]", ",", 
                   "kboff", ",", "kmax", ",", "kmax", ",", "kbon", ",", 
                   "kmax", ",", "kuoff", ",", "konu"}], "]"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{"kmin", "<=", "kboff", "<=", "kdl"}], ",", 
