      RowBox[{"konb_", "?", "NumericQ"}], ",", 
      RowBox[{"koffu_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Tau]eval", ",", "integral", ",", "A1", ",", "A2", ",", "A3", ",", 
        "B1", ",", "B2", ",", "B3", ",", "C1", ",", "C2", ",", "C3", ",", 
        "C4", ",", "C5", ",", "C6"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"\[Tau]eval", "=", 
        RowBox[{"\[Tau]fun", "[", 
         RowBox[{
         "c", ",", "c2", ",", "\[Gamma]", ",", "kboff", ",", "kbon", ",", 
          "kuoff", ",", "kuon", ",", "konb", ",", "koffu"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"C1", "=", 
        RowBox[{
         RowBox[{"c", " ", "kboff", " ", 
          SuperscriptBox["konb", "2"]}], "+", 
         RowBox[{"c2", " ", "kboff", " ", 
          SuperscriptBox["konb", "2"]}], "+", 
         RowBox[{"c2", " ", "kboff", " ", "konb", " ", "kuoff"}], "+", 
         RowBox[{
         "c", " ", "kboff", " ", "konb", " ", "kuoff", " ", "\[Gamma]"}]}]}], 
       ";", 
       RowBox[{"C2", "=", 
        RowBox[{
         RowBox[{"2", " ", "c", " ", "kboff", " ", "konb"}], "+", 
         RowBox[{"2", " ", "c2", " ", "kboff", " ", "konb"}], "+", 
         SuperscriptBox["konb", "2"], "+", 
         RowBox[{"c2", " ", "kboff", " ", "kuoff"}], "+", 
         RowBox[{"konb", " ", "kuoff"}], "+", 
         RowBox[{"c", " ", "kboff", " ", "kuoff", " ", "\[Gamma]"}], "+", 
         RowBox[{"konb", " ", "kuoff", " ", "\[Gamma]"}], "+", 
         RowBox[{
          SuperscriptBox["kuoff", "2"], " ", "\[Gamma]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"C3", "=", 
        RowBox[{
         RowBox[{"c", " ", "kboff"}], "+", 
         RowBox[{"c2", " ", "kboff"}], "+", 
         RowBox[{"2", " ", "konb"}], "+", "kuoff", "+", 
         RowBox[{"kuoff", " ", "\[Gamma]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"C4", "=", 
        RowBox[{"koffu", " ", 
         SuperscriptBox["kuon", "2"], " ", "\[Gamma]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"C5", "=", 
        RowBox[{
         RowBox[{"c2", " ", "kbon", " ", "kuon"}], "+", 
         RowBox[{"koffu", " ", "kuon"}], "+", 
         RowBox[{"c", " ", "kbon", " ", "kuon", " ", "\[Gamma]"}], "+", 
         RowBox[{"koffu", " ", "kuon", " ", "\[Gamma]"}], "+", 
         RowBox[{
          SuperscriptBox["kuon", "2"], " ", "\[Gamma]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"C6", "=", 
        RowBox[{
         RowBox[{"c", " ", "kbon"}], "+", 
         RowBox[{"c2", " ", "kbon"}], "+", "koffu", "+", "kuon", "+", 
         RowBox[{"kuon", " ", "\[Gamma]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"A1", "=", 
        RowBox[{"Root", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"C1", "+", 
            RowBox[{"C2", "#1"}], "+", 
            RowBox[{"C3", " ", 
             SuperscriptBox["#1", "2"]}], "+", 
            SuperscriptBox["#1", "3"]}], "&"}], ",", "1"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"A2", "=", 
