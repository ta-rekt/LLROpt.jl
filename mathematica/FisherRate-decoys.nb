     "koffu"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"FisherFastcr", "[", 
     RowBox[{
      RowBox[{"c_", "?", "NumericQ"}], ",", 
      RowBox[{"c2_", "?", "NumericQ"}], ",", 
      RowBox[{"\[Gamma]_", "?", "NumericQ"}], ",", 
