             " ", "\[IndentingNewLine]", 
            RowBox[{"PrecisionGoal", "->", "6"}], ",", "\[IndentingNewLine]", 
            
            RowBox[{"AccuracyGoal", "->", "6"}], ",", "\[IndentingNewLine]", 
            RowBox[{"MinRecursion", "->", "1"}], ",", "\[IndentingNewLine]", 
            RowBox[{"MaxRecursion", "->", "10"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"integral", "*", 
         RowBox[{
          RowBox[{"c0i", "^", "2"}], "/", "\[Tau]PartialEval"}]}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FisherSafe", "[", 
