          RowBox[{"Method", "->", 
           RowBox[{"{", "\"\<DoubleExponential\>\"", "}"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"PrecisionGoal", "->", "5"}], ",", "\[IndentingNewLine]", 
          RowBox[{"MinRecursion", "->", "3"}], ",", "\[IndentingNewLine]", 
          RowBox[{"MaxRecursion", "->", "10"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
