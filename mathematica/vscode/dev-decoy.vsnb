    "success": true
   }
  },
  {
   "kind": 2,
   "value": "ToString[weights2]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "{c kboff, kuoff, c2 kboff, kuoff γ, c kbon, kuon, c2 kbon, kuon γ, konb, koffu, konb, koffu, c2 kbon, c kbon}",
       "mime": "text/html"
      }
     ],
     "id": "65fd4f89-a8dd-4fa0-acc1-af1af78f1cca"
    }
