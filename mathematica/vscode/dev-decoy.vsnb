  {
   "kind": 1,
   "value": "### Steady-state quantities",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Q2 = RateMatrix[edges2, weights2, nstates2];\nss2 = SteadyStateProbabilities[Q2];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1748475028889,
     "endTime": 1748475028919
    },
