  {
   "kind": 1,
   "value": "## Dependence of FIR on concentration",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "### Create CTMC graph from edges and weights",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "HomeDir = \"/home/tohme/.julia/dev/LLROpt/\";\ncircuitData = Import[HomeDir<>\"spec/circuits.json\", \"RawJSON\"];\n\ncircuitId = \"1bs_decoy_no_konu\";\nedges2 = circuitData[circuitId][\"edges\"];\nweights2 = ToExpression[circuitData[circuitId][\"weight_labels\"]];\nnstates2 = circuitData[circuitId][\"nstates\"];\nvertexPartition = circuitData[circuitId][\"vertex_partition\"];\nnedges2 = Length[edges2];\noffInd = circuitData[circuitId][\"off_indicator\"]; \nonInd = 1-offInd;\n\nassum = c >= 0 && kboff > 0 && kboff2 > 0 && kuon > 0 && kuon2 > 0 && \n   kbon > 0 && kbon2 > 0 && kon1b > 0 && kuoff > 0 && kuoff2 > 0 && \n   kon2b > 0 && koffu > 0;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1748475028847,
     "endTime": 1748475028855
    },
    "executionOrder": 59,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "(*Plot the circuit*)\nedgeList = Table[edges2[[i, 1]] -> edges2[[i, 2]], {i, 1, nedges2}];\ng = Graph[edges2, VertexLabels -> \"Name\", DirectedEdges -> True, \n  EdgeLabels -> \n   Table[edgeList[[i]] -> \n     Placed[(HoldForm /@ weights2)[[i]], 0.55], {i, 1, nedges2}], \n  ImageSize -> 250, \n  GraphLayout -> {\"MultipartiteEmbedding\", \n    \"VertexPartition\" -> vertexPartition}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:200.4px;height:156.0px;\" aspect-ratio=\"0.778443\" tabIndex=\"-1\"><img src=\"data:image/png;base64,\" /></wgraph></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "dad96e1e-32e7-4a9b-a43a-fbaccad76426"
    }
   ],
