   "kind": 2,
   "value": "ClearAll[outData]\n\n{data, params} = GetData[\"20250527/bivariate-fisher-w-g-lowc-4\"];\n\noutData = <|\"1\"-><|\"1\"-><|\"1\"->{}|>|>|>;\noutData[\"circuit_id\"] = circuitId;\n\nnrates = 6;\nvars = {c, c2, \\[Gamma], kboff, konb, kuon, kbon, koffu, kuoff};\n\nDo[\n    skc = ToString[kc];\n    skg = ToString[kg];\n    skw = ToString[kw];\n\n    If[!KeyExistsQ[outData, skc], outData[skc] = <||>];\n    If[!KeyExistsQ[outData[skc], skg], outData[skc, skg] = <||>];\n    \n    logrates = data[skc, skg, skw][[;; nrates]];\n    rates = Table[10^logrates[[i]], {i, 1, nrates}];\n    c0val = 0.1;\n    wval = params[\"betas\"][[kc]];\n    γval = params[\"gammas\"][[kg]];\n    c2val = wval*c0val;\n\n    cgwRates = Join[{c0val, c2val, γval}, rates];\n\n    Q2val = Q2 /. Table[vars[[i]] -> cgwRates[[i]], {i, 1, nrates+3}];\n    ss2val = ss2 /. Table[vars[[i]] -> cgwRates[[i]], {i, 1, nrates+3}];\n    (* specVal = spec /. Table[vars[[i]] -> cgwRates[[i]], {i, 1, nrates+3}]; *)\n\n    outData[skc, skg, skw] = <|\n        \"c0\" -> c0val,\n        \"gamma\" -> γval,\n        \"omega\" -> c2val/c0val,\n        \"c2\" -> c2val,\n        \"rates\" -> rates,\n        \"logrates\" -> logrates,\n        \"rate_matrix\" -> Q2val,\n        \"ss_prob\" -> ss2val,\n        \"fisher_cr\" -> FisherSafecr @@ cgwRates,\n        \"fisher_cw\" -> FisherSafecw @@ cgwRates,\n        \"fisher_cross\" -> FisherSafecross @@ cgwRates\n    |>;\n    , {kc, 1, 32}, {kg, 1, 8}, {kw, 1, 1}\n];",
