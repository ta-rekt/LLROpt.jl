  {
   "kind": 1,
   "value": "## Dependence of FIR on concentration",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "### Create CTMC graph from edges and weights",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "HomeDir = \"/home/tohme/.julia/dev/LLROpt/\";\ncircuitData = Import[HomeDir<>\"spec/circuits.json\", \"RawJSON\"];\n\ncircuitId = \"1bs_decoy_no_konu_new\";\nedges2 = circuitData[circuitId][\"edges\"];\nweights2 = ToExpression[circuitData[circuitId][\"weight_labels\"]];\nnstates2 = circuitData[circuitId][\"nstates\"];\nvertexPartition = circuitData[circuitId][\"vertex_partition\"];\nnedges2 = Length[edges2];\noffInd = circuitData[circuitId][\"off_indicator\"]; \nonInd = 1-offInd;\n\nassum = c >= 0 && kboff > 0 && kboff2 > 0 && kuon > 0 && kuon2 > 0 && \n   kbon > 0 && kbon2 > 0 && kon1b > 0 && kuoff > 0 && kuoff2 > 0 && \n   kon2b > 0 && koffu > 0;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747334972107,
     "endTime": 1747334972120
    },
    "executionOrder": 337,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "(*Plot the circuit*)\nedgeList = Table[edges2[[i, 1]] -> edges2[[i, 2]], {i, 1, nedges2}];\ng = Graph[edges2, VertexLabels -> \"Name\", DirectedEdges -> True, \n  EdgeLabels -> \n   Table[edgeList[[i]] -> \n     Placed[(HoldForm /@ weights2)[[i]], 0.55], {i, 1, nedges2}], \n  ImageSize -> 250, \n  GraphLayout -> {\"MultipartiteEmbedding\", \n    \"VertexPartition\" -> vertexPartition}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:400.2px;height:285.0px;\" aspect-ratio=\"0.712144\" tabIndex=\"-1\"><img src=\"data:image/png;base64,\" /></wgraph></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "8b967534-9784-4d8d-b633-bc2adb29c6fe"
    }
   ],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747334972596,
     "endTime": 1747334972713
    },
    "executionOrder": 340,
    "success": true
   }
  },
  {
   "kind": 1,
   "value": "### Steady-state quantities",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Q2 = RateMatrix[edges2, weights2, nstates2];\nss2 = SteadyStateProbabilities[Q2];\nMatrixForm[Q2]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:1309.8px;height:216.0px;\" aspect-ratio=\"0.164911\" tabIndex=\"-1\"><img src=\"data:image/png;base64,\" /></wgraph></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "a03f15c4-42b7-4f75-a198-37b0238b6397"
    }
   ],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747334188287,
     "endTime": 1747334188436
    },
    "executionOrder": 322,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "spec=(ss2[[3]]+ss2[[7]])/(ss2[[3]]+ss2[[4]]+ss2[[5]]+ss2[[7]]) // Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747334311604,
     "endTime": 1747334311608
    },
