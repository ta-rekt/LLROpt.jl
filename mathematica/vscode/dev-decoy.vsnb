   }
  },
  {
   "kind": 1,
   "value": "### Generating test cases",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "#### Test set generated from optimization output",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[outData]\n\n{data, params} = GetData[\"20250505/fir-cr-cw-g-mean-pooled-2\"];\n\noutData = <|\"1\" -> <|\"1\" -> <|\"1\" -> {}|>|>|>;\noutData[\"circuit_id\"] = circuitId;\n\nnrates = 6;\nvars = {c, γ, c2, kboff, kuoff, kbon, kuon, konb, koffu};\n\nDo[\n    skc = ToString[kc];\n    skg = ToString[kg];\n    skw = ToString[kw];\n\n    If[!KeyExistsQ[outData, skc], outData[skc] = <||>];\n    If[!KeyExistsQ[outData[skc], skg], outData[skc, skg] = <||>];\n    \n    logrates = data[skc, skg, skw][[;; nrates]];\n    rates = Table[10^logrates[[i]], {i, 1, nrates}];\n    c0val = params[\"betas\"][[kc]];\n    γval = params[\"gammas\"][[kg]];\n    c2val = params[\"wvals\"][[kw]]*c0val;\n\n    cgwRates = Join[{c0val, γval, c2val}, rates];\n\n    Q2val = Q2 /. Table[vars[[i]] -> cgwRates[[i]], {i, 1, nrates+3}];\n    ss2val = ss2 /. Table[vars[[i]] -> cgwRates[[i]], {i, 1, nrates+3}];\n    specVal = spec /. Table[vars[[i]] -> cgwRates[[i]], {i, 1, nrates+3}];\n\n    outData[skc, skg, skw] = <|\n        \"c0\" -> c0val,\n        \"gamma\" -> γval,\n        \"omega\" -> c2val/c0val,\n        \"c2\" -> c2val,\n        \"rates\" -> rates,\n        \"logrates\" -> logrates,\n        \"rate_matrix\" -> Q2val,\n        \"ss_prob\" -> ss2val,\n        \"specificity\" -> specVal\n    |>;\n    , {kc, 1, 32}, {kg, 1, 3}, {kw, 1, 5}\n];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "#### Export test set",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "filename = \"20250505/fir-cr-cw-g-mean-pooled-2-testset.json\";\ndir = FileNameJoin[{$HomeDirectory, \".julia/dev/LLROpt/test/data\"}];\nfilepath = FileNameJoin[{dir, filename}];\n\nExport[filepath, outData, \"RawJSON\"]",
   "languageId": "wolfram",
   "mime": "text/markdown",
   "outputs": [
    {
     "items": [
      {
       "data": "/home/tohme/.julia/dev/LLROpt/test/data/20250505/fir-cr-cw-g-mean-pooled-2-testset.json",
       "mime": "text/html"
