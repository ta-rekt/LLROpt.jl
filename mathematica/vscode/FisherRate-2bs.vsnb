{
 "cells": [
  {
   "kind": 2,
   "value": "AppendTo[$Path, \"/home/tohme/.julia/dev/LLROpt/mathematica-nbs\"];\nGet[\"ctmc`\"]\nGet[\"utils`\"]",
   "languageId": "wolfram",
   "outputs": [],
