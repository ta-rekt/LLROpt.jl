   }
  },
  {
   "kind": 2,
   "value": "integrandNum[1.1, 1.4, 1.5, 1.2, 1.9, 2.2, 1.1, 1.4, 1.5, 1.2, 1.9, \\\n2.2, 2., 1.4, 1.5, 2.6, 3.7, 2.8, 1.9, 3.0, 2.1, 3.2, 2.3, 1.4, 1.5]",
   "languageId": "wolfram",
   "outputs": [
