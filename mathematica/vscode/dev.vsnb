       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:946.2px;height:71.4px;\" aspect-ratio=\"0.0754597\" tabIndex=\"-1\"><img src=\"data:image/png;base64,\" /></wgraph></div>",
