  {
   "kind": 2,
   "value": "kmin = 0.0001;\nkmax = 5.;\nkdl = 0.0888;\nc0 = 100.;\ngamma = 1.095;\nkb = Min[kdl, gamma*kmax/c0]\n(*         c, kboff2, kuoff, kuon, kbon2, kon1b, kboff,kbon, kuoff2, kon2b, kuon2, koffu*)\nFisherSafe[c0,   kb,  kmax,  kmax,  kmin, kmin,  kb,   kmin, kmin,   kmax,  2*kmax,  kmax]",
   "languageId": "wolfram",
