   }
  },
  {
   "kind": 1,
   "value": "# Dependence of FIR on concentration",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "## 2 binding sites",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 1,
   "value": "### Create CTMC graph from edges and weights",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "HomeDir = \"/home/tohme/.julia/dev/LLROpt/\";\ncircuitData = Import[HomeDir<>\"spec/circuits.json\", \"RawJSON\"];\n\ncircuitId = \"2bs_no_konu\";\nedges2 = circuitData[circuitId][\"edges\"];\nweights2 = ToExpression[circuitData[circuitId][\"weight_labels\"]];\nnstates2 = circuitData[circuitId][\"nstates\"];\nvertexPartition = circuitData[circuitId][\"vertex_partition\"];\nnedges2 = Length[edges2];\noffInd = circuitData[circuitId][\"off_indicator\"]; \nonInd = 1-offInd;\n\nassum = c >= 0 && kboff > 0 && kboff2 > 0 && kuon > 0 && kuon2 > 0 && \n   kbon > 0 && kbon2 > 0 && kon1b > 0 && kuoff > 0 && kuoff2 > 0 && \n   kon2b > 0 && koffu > 0;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747096720377,
     "endTime": 1747096720403
    },
    "executionOrder": 617,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "(*Plot the circuit*)\nedgeList = Table[edges2[[i, 1]] -> edges2[[i, 2]], {i, 1, nedges2}];\ng = Graph[edges2, VertexLabels -> \"Name\", DirectedEdges -> True, \n  EdgeLabels -> \n   Table[edgeList[[i]] -> \n     Placed[(HoldForm /@ weights2)[[i]], 0.55], {i, 1, nedges2}], \n  ImageSize -> 250, \n  GraphLayout -> {\"MultipartiteEmbedding\", \n    \"VertexPartition\" -> vertexPartition}]",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:400.2px;height:307.8px;\" aspect-ratio=\"0.769115\" tabIndex=\"-1\"><img src=\"data:image/png;base64,\" /></wgraph></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "8c9967fe-01ec-4561-8b98-70996e5b260c"
    }
   ],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747096720855,
     "endTime": 1747096720950
    },
    "executionOrder": 620,
    "success": true
   }
  },
  {
   "kind": 1,
   "value": "### Steady-state quantities",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "Q2 = RateMatrix[edges2, weights2, nstates2];\nss2 = SteadyStateProbabilities[Q2];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000820350,
     "endTime": 1747000820400
    },
    "executionOrder": 22,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "(*Variance rate*)\nvar=VarianceRate[Q2, onInd];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000820401,
     "endTime": 1747000821468
    },
    "executionOrder": 24,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "(*Sharpness*)\npiOn = onInd.ss2;\ndpiOn = D[piOn, {c, 1}];\nsharp = c*dpiOn // Simplify;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000821468,
     "endTime": 1747000821775
    },
    "executionOrder": 28,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "(*Fisher information rate with accumulated decoding*)\nFisherRateAcc = sharp^2 / var;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000821775,
     "endTime": 1747000821782
    },
    "executionOrder": 30,
    "success": true
   }
  },
  {
   "kind": 1,
   "value": "### Laplace transform of first hitting times",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(*Laplace transform of FPTs for individual hitting states*)\nFon = LaplaceTransformFPT[Q2, s2];\nF25 = Fon[[2, 5]][[1]];\nF45 = Fon[[4, 5]][[1]];\nF65 = Fon[[6, 5]][[1]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000821783,
     "endTime": 1747000838646
    },
    "executionOrder": 35,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "(*Laplace for hitting set, joint with the hitting state*)\noffStates = {5, 1, 3};\nonStates = {6, 2, 4};\nF5on = LaplaceTransformToSetByState[Q2, 5, onStates, s1];\nFoffOn = F5on[[2]][[1]]*F25 + F5on[[3]][[1]]*F45 + F5on[[1]][[1]]*F65;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000838647,
     "endTime": 1747000838679
    },
    "executionOrder": 40,
    "success": true
   }
  },
  {
   "kind": 1,
   "value": "### Mean, variance and cov. of FPTs",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "(*Means, \\\nvariances and covariances of FPTs from the Laplace transforms*)\npartials1 = With[{s1 = 0, s2 = 0}, Evaluate[D[FoffOn, {s1, 1}]]];\npartials2 = With[{s1 = 0, s2 = 0}, Evaluate[D[FoffOn, {s2, 1}]]];\npartials1s1 = With[{s1 = 0, s2 = 0}, Evaluate[D[FoffOn, {s1, 2}]]];\npartials2s2 = With[{s1 = 0, s2 = 0}, Evaluate[D[FoffOn, {s2, 2}]]];\npartials1s2 = \n  With[{s1 = 0, s2 = 0}, Evaluate[D[D[FoffOn, {s2, 1}], {s1, 1}]]];\n\nmeanToffLt = -partials1;\nmeanTonLt = -partials2;\nvarToffLt = partials1s1 - meanToffLt^2;\nvarTonLt = partials2s2 - meanTonLt^2;\ncovTonToff = partials1s2 - meanToffLt*meanTonLt;\n\\[Tau] = Simplify[meanToffLt + meanTonLt, assum];\n\n\\[Tau]fun[c_?NumericQ, kboff_?NumericQ, kboff2_?NumericQ, \n   kbon_?NumericQ, kbon2_?NumericQ, koffu_?NumericQ, kon1b_?NumericQ, \n   kon2b_?NumericQ, kuoff_?NumericQ, kuoff2_?NumericQ, kuon_?NumericQ,\n    kuon2_?NumericQ ] := Evaluate[\\[Tau]];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000838679,
     "endTime": 1747000838774
    },
    "executionOrder": 53,
    "success": true
   }
  },
  {
   "kind": 1,
   "value": "### Actual FPT distribution",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "expr1 = FoffOn;\nexpr2 = Factor[expr1, Modulus -> 0];\nexprS1 = Apart[expr2, s1];  (*treat s2,parameters as constants*)\nexprS12 = Apart[exprS1, s2];\n\nPjoint = \n  InverseLaplaceTransform[exprS12, {s1, s2}, {t1, t2}, \n   Assumptions -> assum];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000838774,
     "endTime": 1747000844866
    },
    "executionOrder": 58,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "ClearAll[PjointNum]\n\n(*Joint probability density function of the first-passage times*)\nPjointNum[t1_?NumericQ, t2_?NumericQ, c_?NumericQ, kboff2_?NumericQ, kuoff_?NumericQ, \n   kuon_?NumericQ, kbon2_?NumericQ, kon1b_?NumericQ, kboff_?NumericQ, \n   kbon_?NumericQ, kuoff2_?NumericQ, kon2b_?NumericQ, kuon2_?NumericQ,\n    koffu_?NumericQ ]:=Evaluate[Pjoint];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000844866,
     "endTime": 1747000844875
    },
    "executionOrder": 61,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "PjointNum[0.001, 0.1, 100., 0.0541925, 4.40821, 4.61333, 0.00175545, \n0.00674974, 0.0361109, 0.0041057, 0.00930819, 4.92382, 8.04452, 4.99952]//ScientificForm",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "<div class=\"wexpr\"><wgraph class=\"resizable\" style=\"width:148.2px;height:25.8px;\" aspect-ratio=\"0.174089\" tabIndex=\"-1\"><img src=\"data:image/png;base64,\" /></wgraph></div>",
       "mime": "x-application/wolfram-language-html"
      }
     ],
     "id": "5e2e06e5-7b14-4328-b634-7250c92380bf"
    }
   ],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000844875,
     "endTime": 1747000844965
    },
    "executionOrder": 62,
    "success": true
   }
  },
  {
   "kind": 1,
   "value": "### Simplify and compile integrand of the Fisher information",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "integrand = D[Pjoint, {c, 1}]^2/Pjoint;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000844965,
     "endTime": 1747000844988
    },
    "executionOrder": 63,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "integrandSimpl = \n  integrand //. {Root[\n      c^2 kboff kboff2 kon2b + c kboff2 kon1b kon2b + \n        c kboff2 kon1b kuoff2 + (c^2 kboff kboff2 + c kboff2 kon1b + \n           c kboff kon2b + c kboff2 kon2b + kon1b kon2b + \n           kon2b kuoff + c kboff2 kuoff2 + kon1b kuoff2 + \n           kuoff kuoff2) #1 + (c kboff + c kboff2 + kon1b + kon2b + \n           kuoff + kuoff2) #1^2 + #1^3 &, 1] -> A1,\n    Root[\n      c^2 kboff kboff2 kon2b + c kboff2 kon1b kon2b + \n        c kboff2 kon1b kuoff2 + (c^2 kboff kboff2 + c kboff2 kon1b + \n           c kboff kon2b + c kboff2 kon2b + kon1b kon2b + \n           kon2b kuoff + c kboff2 kuoff2 + kon1b kuoff2 + \n           kuoff kuoff2) #1 + (c kboff + c kboff2 + kon1b + kon2b + \n           kuoff + kuoff2) #1^2 + #1^3 &, 2] -> A2,\n    Root[\n      c^2 kboff kboff2 kon2b + c kboff2 kon1b kon2b + \n        c kboff2 kon1b kuoff2 + (c^2 kboff kboff2 + c kboff2 kon1b + \n           c kboff kon2b + c kboff2 kon2b + kon1b kon2b + \n           kon2b kuoff + c kboff2 kuoff2 + kon1b kuoff2 + \n           kuoff kuoff2) #1 + (c kboff + c kboff2 + kon1b + kon2b + \n           kuoff + kuoff2) #1^2 + #1^3 &, 3] -> A3,\n    Root[\n      koffu kuon kuon2 + (c^2 kbon kbon2 + c kbon koffu + koffu kuon +\n            c kbon2 kuon2 + koffu kuon2 + kuon kuon2) #1 + (c kbon + \n           c kbon2 + koffu + kuon + kuon2) #1^2 + #1^3 &, 1] -> B1,\n    Root[\n      koffu kuon kuon2 + (c^2 kbon kbon2 + c kbon koffu + koffu kuon +\n            c kbon2 kuon2 + koffu kuon2 + kuon kuon2) #1 + (c kbon + \n           c kbon2 + koffu + kuon + kuon2) #1^2 + #1^3 &, 2] -> B2,\n    Root[\n      koffu kuon kuon2 + (c^2 kbon kbon2 + c kbon koffu + koffu kuon +\n            c kbon2 kuon2 + koffu kuon2 + kuon kuon2) #1 + (c kbon + \n           c kbon2 + koffu + kuon + kuon2) #1^2 + #1^3 &, 3] -> B3,\n    c^2 kboff kboff2 + c kboff2 kon1b + c kboff kon2b + \n      c kboff2 kon2b + kon1b kon2b + kon2b kuoff + c kboff2 kuoff2 + \n      kon1b kuoff2 + kuoff kuoff2 -> C1,\n    c kboff + c kboff2 + kon1b + kon2b + kuoff + kuoff2 -> C2,\n    c^2 kbon kbon2 + c kbon koffu + koffu kuon + c kbon2 kuon2 + \n      koffu kuon2 + kuon kuon2 -> C3,\n    2 c kboff kboff2 + kboff2 kon1b + kboff kon2b + kboff2 kon2b + \n      kboff2 kuoff2 -> C4,\n    -2 c kboff kboff2 kon2b - kboff2 kon1b kon2b - \n      kboff2 kon1b kuoff2 -> C5,\n    2 c kbon kbon2 + kbon koffu + kbon2 kuon2 -> C6};",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000844988,
     "endTime": 1747000845085
    },
    "executionOrder": 64,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "integrandSimpl /. {t1 -> 0.1, t2 -> 1, c -> 1., c2 -> 1., kboff -> 2.,\n   kboff2 -> 2., kbon -> 2., kbon2 -> 2., konb -> 3., konu -> 1., \n  kuon -> 1., kuon2 -> 1., kon1b -> 1., kon2b -> 4., koffu -> 3., \n  kuoff -> 2., kuoff2 -> 2., kuon -> 1., A1 -> 2., B1 -> 2.1, \n  A2 -> 2.2, B2 -> 2.3, A3 -> 2.4, B3 -> 2.5, C1 -> 2., C2 -> 2.1, \n  C3 -> 2.2, C4 -> 2.3, C5 -> 2.4, C6 -> 2.5}",
   "languageId": "wolfram",
   "outputs": [
    {
     "items": [
      {
       "data": "4.78358",
       "mime": "text/html"
      }
     ],
     "id": "1d082949-7a23-41cb-9ecf-f39bece2646c"
    }
   ],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000845085,
     "endTime": 1747000845146
    },
    "executionOrder": 65,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "vars = Complement[\n    DeleteDuplicates@\n     Cases[integrandSimpl, _Symbol, {0, Infinity}], {E, I, Pi}] // \n   Sort;\npattern1 = Sequence @@ (# <> \"_?NumericQ\" & /@ ToString /@ vars);\npattern2 = {#, _Real} & /@ vars;\npattern3 = \"N[\" <> # <> \"]\" & /@ ToString /@ vars;",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
    "timing": {
     "startTime": 1747000845146,
     "endTime": 1747000845156
    },
    "executionOrder": 69,
    "success": true
   }
  },
  {
   "kind": 2,
   "value": "integrandC = \n Compile[{{A1, _Real}, {A2, _Real}, {A3, _Real}, {B1, _Real}, {B2, \\\n_Real}, {B3, _Real}, {c, _Real}, {C1, _Real}, {C2, _Real}, {C3, \\\n_Real}, {C4, _Real}, {C5, _Real}, {C6, _Real}, {kboff, _Real}, \\\n{kboff2, _Real}, {kbon, _Real}, {kbon2, _Real}, {koffu, _Real}, \\\n{kon1b, _Real}, {kon2b, _Real}, {kuoff2, _Real}, {kuon, _Real}, \\\n{kuon2, _Real}, {t1, _Real}, {t2, _Real}},\n  Evaluate[integrandSimpl],\n  CompilationTarget -> \"C\",\n  RuntimeOptions -> \"Speed\"]",
   "languageId": "wolfram",
   "outputs": [
