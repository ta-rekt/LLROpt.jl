   "kind": 2,
   "value": "(* FindMaximum[{\n  FisherSafe[c0, kboff2, kuoff, kuon, kbon2, kon1b, kboff, kbon, \n   kuoff2, kon2b, kuon2, koffu],\n  constraints},\n Table[{vars[[i]], rates[[i]]}, {i, 1, nparams}],\n AccuracyGoal -> 3,\n PrecisionGoal -> 3,\n MaxIterations -> 10\n ] *)",
   "languageId": "wolfram",
