  {
   "kind": 2,
   "value": "(* {data, params} = GetData[\"20250521/2bs-fir-c0\"];\n\noutData = <|\"1\"-><|\"1\"-><|\"1\"->{}|>|>|>;\noutData[\"circuit_id\"] = circuitId;\n\nnrates = 11;\nvars = {c, kboff2, kuoff, kuon, kbon2, kon1b, \n        kboff, kbon, kuoff2, kon2b, kuon2, koffu};\n\nDo[\n    skc = ToString[kc];\n    skg = ToString[kg];\n    skw = ToString[kw];\n\n    outData[skc] = <||>;\n    outData[skc, skg] = <||>;\n    outData[skc, skg, skw] = <||>;\n\n    (* rates = Table[i, {i, 1, nrates}];\n    logrates = Table[N[Log[10,i]], {i, 1, nrates}]; *)\n\n    logrates = data[skc, skg, skw][[;; nrates]];\n    rates = Table[10^logrates[[i]], {i, 1, nrates}];\n    cval = params[\"betas\"][[kc]];\n\n    t1val = 0.1;\n    t2val = 0.1;\n    cRates = Join[{cval}, rates];\n    t1t2cRates = Join[{t1val, t2val, cval}, rates];\n\n    Q2val = Q2 /. Table[vars[[i]] -> cRates[[i]], {i, 1, nrates+1}];\n    ss2val = ss2 /. Table[vars[[i]] -> cRates[[i]], {i, 1, nrates+1}];\n    meanToffVal = meanToffLt /. Table[vars[[i]] -> cRates[[i]], {i, 1, nrates+1}];\n    meanTonVal = meanTonLt /. Table[vars[[i]] -> cRates[[i]], {i, 1, nrates+1}];\n    FisherRateAccVal = FisherRateAcc /. Table[vars[[i]] -> cRates[[i]], {i, 1, nrates+1}];\n    varVal = var /. Table[vars[[i]] -> cRates[[i]], {i, 1, nrates+1}];\n    sharpVal = sharp /. Table[vars[[i]] -> cRates[[i]], {i, 1, nrates+1}];\n    integrandVal = integrand /. Table[vars[[i]] -> cRates[[i]], {i, 1, nrates+1}];\n\n    outData[skc, skg, skw] = <|\n        \"c0\" -> cval,\n        \"t1\" -> t1val,\n        \"t2\" -> t2val,\n        \"rates\" -> rates,\n        \"logrates\" -> logrates,\n        \"rate_matrix\" -> Q2val,\n        \"ss_prob\" -> ss2val,\n        \"tau_off\" -> meanToffVal,\n        \"tau_on\" -> meanTonVal,\n        \"var_rate\" -> varVal,\n        \"sharpness\" -> sharpVal,\n        \"fisher_rate_acc\" -> FisherRateAccVal,\n        \"fisher_rate\" -> FisherSafe @@ cRates,\n        \"integrand\" -> integrandVal /. {t1 -> t1val, t2 -> t2val},\n        \"p_joint\" -> PjointNum @@ t1t2cRates\n    |>;\n    ,{kc, 1, 32}, {kg, 1, 1}, {kw, 1, 1}\n]; *)",
   "languageId": "wolfram",
