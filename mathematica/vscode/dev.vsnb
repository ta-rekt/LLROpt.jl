  {
   "kind": 2,
   "value": "ClearAll[constraints]\n\nlb = Table[kmin, {i, 1, nrates}];\nub = Table[kmax, {i, 1, nrates}];\nub[[1]] = 2*kdl;\nub[[4]] = 2*kdl;\nub[[6]] = kdl;\nub[[7]] = kdl;\nub[[8]] = 2*kmax;\nub[[10]] = 2*kmax;\n\nvars = {kboff2, kuoff, kuon, kbon2, kon1b, kboff, kbon, kuoff2, kon2b, kuon2, koffu};\nconstraints = Table[lb[[i]] <= vars[[i]] <= ub[[i]], {i, 1, nrates}];",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
