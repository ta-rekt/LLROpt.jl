  {
   "kind": 1,
   "value": "### Fisher information",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "ClearAll[FisherFast];\nClearAll[FisherSafe];\n(*kboff2,kuoff,kuon,c*kbon2,kon1b,c*kboff,c*kbon,kuoff2,kon2b,kuon2,\\\nkoffu*)\nFisherFast[c_?NumericQ, kboff2_?NumericQ, kuoff_?NumericQ, \n   kuon_?NumericQ, kbon2_?NumericQ, kon1b_?NumericQ, kboff_?NumericQ, \n   kbon_?NumericQ, kuoff2_?NumericQ, kon2b_?NumericQ, kuon2_?NumericQ,\n    koffu_?NumericQ ] := \n  Module[{\\[Tau]eval, integral, A1, A2, A3, B1, B2, B3, C1, C2, C3, \n    C4, C5, C6},\n   \\[Tau]eval = \\[Tau]fun[c, kboff, kboff2, kbon, kbon2, koffu, kon1b,\n      kon2b, kuoff, kuoff2, kuon, kuon2];\n   A1 = Root[\n     c^2 kboff kboff2 kon2b + c kboff2 kon1b kon2b + \n       c kboff2 kon1b kuoff2 + (c^2 kboff kboff2 + c kboff2 kon1b + \n          c kboff kon2b + c kboff2 kon2b + kon1b kon2b + kon2b kuoff +\n           c kboff2 kuoff2 + kon1b kuoff2 + \n          kuoff kuoff2) #1 + (c kboff + c kboff2 + kon1b + kon2b + \n          kuoff + kuoff2) #1^2 + #1^3 &, 1];\n   A2 = Root[\n     c^2 kboff kboff2 kon2b + c kboff2 kon1b kon2b + \n       c kboff2 kon1b kuoff2 + (c^2 kboff kboff2 + c kboff2 kon1b + \n          c kboff kon2b + c kboff2 kon2b + kon1b kon2b + kon2b kuoff +\n           c kboff2 kuoff2 + kon1b kuoff2 + \n          kuoff kuoff2) #1 + (c kboff + c kboff2 + kon1b + kon2b + \n          kuoff + kuoff2) #1^2 + #1^3 &, 2];\n   A3 = Root[\n     c^2 kboff kboff2 kon2b + c kboff2 kon1b kon2b + \n       c kboff2 kon1b kuoff2 + (c^2 kboff kboff2 + c kboff2 kon1b + \n          c kboff kon2b + c kboff2 kon2b + kon1b kon2b + kon2b kuoff +\n           c kboff2 kuoff2 + kon1b kuoff2 + \n          kuoff kuoff2) #1 + (c kboff + c kboff2 + kon1b + kon2b + \n          kuoff + kuoff2) #1^2 + #1^3 &, 3];\n   B1 = Root[\n     koffu kuon kuon2 + (c^2 kbon kbon2 + c kbon koffu + koffu kuon + \n          c kbon2 kuon2 + koffu kuon2 + kuon kuon2) #1 + (c kbon + \n          c kbon2 + koffu + kuon + kuon2) #1^2 + #1^3 &, 1]; \n   B2 = Root[\n     koffu kuon kuon2 + (c^2 kbon kbon2 + c kbon koffu + koffu kuon + \n          c kbon2 kuon2 + koffu kuon2 + kuon kuon2) #1 + (c kbon + \n          c kbon2 + koffu + kuon + kuon2) #1^2 + #1^3 &, 2];\n   B3 = Root[\n     koffu kuon kuon2 + (c^2 kbon kbon2 + c kbon koffu + koffu kuon + \n          c kbon2 kuon2 + koffu kuon2 + kuon kuon2) #1 + (c kbon + \n          c kbon2 + koffu + kuon + kuon2) #1^2 + #1^3 &, 3];\n   C1 = c^2 kboff kboff2 + c kboff2 kon1b + c kboff kon2b + \n     c kboff2 kon2b + kon1b kon2b + kon2b kuoff + c kboff2 kuoff2 + \n     kon1b kuoff2 + kuoff kuoff2;\n   C2 = c kboff + c kboff2 + kon1b + kon2b + kuoff + kuoff2;\n   C3 = c^2 kbon kbon2 + c kbon koffu + koffu kuon + c kbon2 kuon2 + \n     koffu kuon2 + kuon kuon2;\n   C4 = 2 c kboff kboff2 + kboff2 kon1b + kboff kon2b + kboff2 kon2b +\n      kboff2 kuoff2;\n   C5 = -2 c kboff kboff2 kon2b - kboff2 kon1b kon2b - \n     kboff2 kon1b kuoff2;\n   C6 = 2 c kbon kbon2 + kbon koffu + kbon2 kuon2;\n   integral = \n    NIntegrate[\n     integrandNum[A1, A2, A3, B1, B2, B3, c, C1, C2, C3, C4, C5, C6, \n      kboff, kboff2, kbon, kbon2, koffu, kon1b, kon2b, kuoff2, kuon, \n      kuon2, t1, t2], {t1, 0, \\[Infinity]}, {t2, 0, \\[Infinity]},\n     Method -> {\"DoubleExponential\"},\n     PrecisionGoal -> 5,\n     MinRecursion -> 3,\n     MaxRecursion -> 10];\n   integral*c^2/\\[Tau]eval];\n\nFisherSafe[pars__?NumericQ] :=\n  Quiet[\n   Check[\n    FisherFast[pars],\n    -1,(* \\[LeftArrow] penalty when NIntegrate fails*)\n    {NIntegrate::ncvb, NIntegrate::inumri, NIntegrate::slowcon}\n    ], {NIntegrate::ncvb, NIntegrate::inumri, NIntegrate::slowcon}\n   ];\n",
   "languageId": "wolfram",
   "outputs": [],
   "metadata": {},
   "executionSummary": {
