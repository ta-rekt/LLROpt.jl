   "value": "{data, params} = GetData[\"20250512/2bs-fir-free-c0-clean\"];\n\nkc = 28;\nkg = 1;\nkw = 1;\nskc = ToString[kc];\nskg = ToString[kg];\nskw = ToString[kw];\nnrates = 11;\nlogrates = data[skc, skg, skw][[;; nrates]];\nrates = Table[10^logrates[[i]], {i, 1, nrates}];\nc0 = params[\"betas\"][[kc]];\ninput = Prepend[rates, c0];\n\nFisherSafe @@ input\ndata[skc, skg, skw][[nrates + 1]]*c0^2",
