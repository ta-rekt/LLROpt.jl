  {
   "kind": 1,
   "value": "### Numeric guards",
   "languageId": "markdown",
   "mime": "text/markdown",
   "outputs": [],
   "metadata": {},
   "executionSummary": {}
  },
  {
   "kind": 2,
   "value": "integrandNum[A1_?NumericQ, A2_?NumericQ, A3_?NumericQ, B1_?NumericQ, \n   B2_?NumericQ, B3_?NumericQ, c_?NumericQ, C1_?NumericQ, \n   C2_?NumericQ, C3_?NumericQ, C4_?NumericQ, C5_?NumericQ, \n   C6_?NumericQ, kboff_?NumericQ, kboff2_?NumericQ, kbon_?NumericQ, \n   kbon2_?NumericQ, koffu_?NumericQ, kon1b_?NumericQ, kon2b_?NumericQ,\n    kuoff2_?NumericQ, kuon_?NumericQ, kuon2_?NumericQ, t1_?NumericQ, \n   t2_?NumericQ] := \n  integrandC[N[A1], N[A2], N[A3], N[B1], N[B2], N[B3], N[c], N[C1], \n   N[C2], N[C3], N[C4], N[C5], N[C6], N[kboff], N[kboff2], N[kbon], \n   N[kbon2], N[koffu], N[kon1b], N[kon2b], N[kuoff2], N[kuon], \n   N[kuon2], N[t1], N[t2]];",
   "languageId": "wolfram",
