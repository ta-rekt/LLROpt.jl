   "kind": 2,
   "value": "(*Edge lists and weights*)\nedges2 = {{5, 1}, {1, 5}, {2, 6}, {6, 2}, {1, 2}, {1, 3}, {2, 4}, {3, \n    1}, {3, 4}, {4, 2}, {6, 5}};\nweights2 = {c*kboff2, kuoff, kuon, c*kbon2, kon1b, c*kboff, c*kbon, \n   kuoff2, kon2b, kuon2, koffu};\nnstates2 = 6;\nnedges2 = Length[edges2];\nassum = c >= 0 && kboff > 0 && kboff2 > 0 && kuon > 0 && kuon2 > 0 && \n   kbon > 0 && kbon2 > 0 && kon1b > 0 && kuoff > 0 && kuoff2 > 0 && \n   kon2b > 0 && koffu > 0;",
   "languageId": "wolfram",
