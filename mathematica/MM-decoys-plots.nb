                RowBox[{"i", ",", "1", ",", "m"}], "}"}]}], "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"RHS", "=", 
                RowBox[{
                 RowBox[{"-", "Q_"}], 
                 RowBox[{"{", 
                  RowBox[{"i", ",", "h_j"}], "}"}]}]}], ",", 
               RowBox[{"for", " ", "each", " ", "i", " ", "in", " ", 
