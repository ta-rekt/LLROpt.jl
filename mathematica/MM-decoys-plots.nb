                    RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"i", ",", "m"}], "}"}], ",", 
                RowBox[{"{", 
                 RowBox[{"j", ",", "m"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Do", "[", 
