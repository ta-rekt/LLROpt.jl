Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Which", " ", "information", " ", "is", " ", "most", " ", 
    RowBox[{"relevant", "?"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"k", " ", "=", " ", "16"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cvals", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"10.", "^", "x"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"-", "2.5"}], ",", "2.5", ",", "k"}], "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wvals", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"10.", "^", "x"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"Subdivide", "[", 
          RowBox[{
           RowBox[{"-", "2"}], ",", "3", ",", "k"}], "]"}]}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cticks", " ", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Subdivide", "[", 
          RowBox[{"k", ",", "8"}], "]"}], "+", "1"}], ",", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"-", "2.5"}], ",", "2.5", ",", "8"}], "]"}]}], "}"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"wticks", " ", "=", " ", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Subdivide", "[", 
          RowBox[{"k", ",", "9"}], "]"}], "+", "1"}], ",", 
        RowBox[{"Subdivide", "[", 
         RowBox[{
          RowBox[{"-", "2."}], ",", "3", ",", "9"}], "]"}]}], "}"}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LogSpecificity", "[", 
     RowBox[{
     "c_", ",", "c2_", ",", "\[Gamma]_", ",", "rates_", ",", "edges_"}], 
     "]"}], ":=", " ", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "n", ",", "Q", ",", " ", "weights", ",", "ss", ",", "kboff", ",", 
        "konb", ",", "kuon", ",", "kbon", ",", "koffu", ",", "kuoff", ",", 
        "konu"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "kboff", ",", "konb", ",", "kuon", ",", "kbon", ",", "koffu", ",", 
          "kuoff", ",", "konu"}], "}"}], " ", "=", " ", 
        RowBox[{"Table", "[", 
         RowBox[{
          RowBox[{"Exp", "[", 
           RowBox[{
            RowBox[{"rates", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", "1", ",", 
            RowBox[{"Length", "[", "rates", "]"}]}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"weights", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"c", "*", "kboff"}], ",", "kuoff", ",", 
          RowBox[{"c2", "*", "kboff"}], ",", 
          RowBox[{"\[Gamma]", "*", "kuoff"}], ",", 
          RowBox[{"c", "*", "kbon"}], ",", "kuon", ",", 
          RowBox[{"c2", "*", "kbon"}], ",", 
          RowBox[{"\[Gamma]", "*", "kuon"}], ",", "konb", ",", "koffu", ",", 
          "konb", ",", "konu"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Q", " ", "=", " ", 
        RowBox[{"RateMatrix", "[", 
         RowBox[{"edges", ",", " ", "weights", ",", "6"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"ss", " ", "=", " ", 
        RowBox[{"SteadyStateProbabilities", "[", "Q", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{
          RowBox[{"ss", "[", 
           RowBox[{"[", "3", "]"}], "]"}], "/", 
          RowBox[{"ss", "[", 
           RowBox[{"[", "5", "]"}], "]"}]}], "]"}], " ", "+", " ", 
        RowBox[{"Log", "[", 
         RowBox[{"c2", "/", 
          RowBox[{"(", 
           RowBox[{"c", "*", "\[Gamma]"}], ")"}]}], "]"}]}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"specdata", " ", "=", " ", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"LogSpecificity", "[", 
        RowBox[{
         RowBox[{"cvals", "[", 
