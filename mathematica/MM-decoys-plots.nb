           RowBox[{"state", ".", 
            RowBox[{"We", "'"}]}], "ll", " ", "handle", " ", "it", " ", 
           RowBox[{"below", "."}]}]}]}], "*)"}], 
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"MemberQ", "[", 
           RowBox[{"hit", ",", "start"}], "]"}], ",", 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{
            "Then", " ", "we", " ", "trivially", " ", "return", " ", "a", " ",
              "vector", " ", "of", " ", "dimension", " ", 
             RowBox[{"Length", "[", "hit", "]"}]}], ",", 
            RowBox[{"where", " ", "the", " ", "entry", " ", 
             RowBox[{"for", "'"}], 
             RowBox[{"start", "'"}], " ", "is", " ", "1"}], ",", 
            RowBox[{"and", " ", "all", " ", "others", " ", "0."}]}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{"Return", "[", 
           RowBox[{"Map", "[", 
