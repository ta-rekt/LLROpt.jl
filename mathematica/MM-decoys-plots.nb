             RowBox[{"sol", "=", 
              RowBox[{"LinearSolve", "[", 
               RowBox[{"eqMatrix", ",", "eqRHS"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"iPos", "=", 
              RowBox[{"First", "@", 
               RowBox[{"Position", "[", 
                RowBox[{"subStates", ",", "start"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"sol", "[", 
              RowBox[{"[", "iPos", "]"}], "]"}]}], ")"}], ",", 
           RowBox[{"{", 
            RowBox[{"hj", ",", "hit"}], "}"}]}], "  ", 
          RowBox[{"(*", 
           RowBox[{"for", " ", "each", " ", "absorbing", " ", "state", " ", 
            RowBox[{"in", "'"}], 
            RowBox[{"hit", "'"}]}], "*)"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "results", "]"}], ";"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LogSpecificity", "[", 
