      RowBox[{"ci_", "?", "NumericQ"}], "]"}], ":=", 
     RowBox[{"NIntegrate", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"f0", ",", "fp", ",", "fm", ",", "dlog"}], "}"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"f0", "=", 
           RowBox[{"PjointPartEval", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"t1", "->", "t1i"}], ",", 
              RowBox[{"t2", "->", "t2i"}], ",", 
              RowBox[{"c", "->", "ci"}]}], "}"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"fp", "=", 
           RowBox[{"PjointPartEval", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"t1", "->", "t1i"}], ",", 
              RowBox[{"t2", "->", "t2i"}], ",", 
              RowBox[{"c", "->", 
               RowBox[{"ci", "+", "\[Delta]"}]}]}], "}"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"fm", "=", 
           RowBox[{"PjointPartEval", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"t1", "->", "t1i"}], ",", 
              RowBox[{"t2", "->", "t2i"}], ",", 
              RowBox[{"c", "->", 
               RowBox[{"ci", "-", "\[Delta]"}]}]}], "}"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"central", "\[Hyphen]", 
            RowBox[{"difference", " ", "derivative", " ", "of", " ", "log"}], 
            "\[Hyphen]", "pdf"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"dlog", "=", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Log", "[", "fp", "]"}], "-", 
              RowBox[{"Log", "[", "fm", "]"}]}], ")"}], "/", 
            RowBox[{"(", 
             RowBox[{"2", " ", "\[Delta]"}], ")"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"dlog", "^", "2"}], "*", "f0"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t1i", ",", "0", ",", "100"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"t2i", ",", "0", ",", "100"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"Method", "->", 
        RowBox[{"{", "\"\<GlobalAdaptive\>\"", "}"}]}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"MaxRecursion", "->", "6"}]}], "]"}]}], ";"}], 
