Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{
    SuperscriptBox["kboff", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "konb", " ", "t"}]], " ", "konb", " ", 
       RowBox[{"(", 
        RowBox[{"konb", "-", 
         RowBox[{"2", " ", "x"}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"2", " ", "t", " ", "x"}]], " ", "konb", " ", 
       RowBox[{"(", 
        RowBox[{"konb", "-", 
         RowBox[{"2", " ", "x"}]}], ")"}]}], "+", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"t", " ", 
         RowBox[{"(", 
          RowBox[{"konb", "+", "x"}], ")"}]}]], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          SuperscriptBox["t", "2"], " ", 
          SuperscriptBox["x", "4"]}], "+", 
         RowBox[{
          SuperscriptBox["konb", "2"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "2"}], "+", 
            RowBox[{
             SuperscriptBox["t", "2"], " ", 
             SuperscriptBox["x", "2"]}]}], ")"}]}], "+", 
         RowBox[{"konb", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"4", " ", "x"}], "-", 
            RowBox[{"2", " ", 
             SuperscriptBox["t", "2"], " ", 
             SuperscriptBox["x", "3"]}]}], ")"}]}]}], ")"}]}]}], ")"}]}], 
   RowBox[{
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"konb", " ", "t"}]], "-", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"t", " ", "x"}]]}], ")"}], "2"], " ", 
    SuperscriptBox[
