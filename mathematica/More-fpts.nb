Cell[BoxData[
 RowBox[{
  RowBox[{"P2", "[", "s", "]"}], ":=", 
  FractionBox[
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"c", "*", "kboff"}], "+", "k0"}], ")"}], "*", "konb"}], 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"s", "+", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c", "*", "kboff"}], "+", "k0"}], ")"}]}], ")"}], "*", 
    RowBox[{"(", 
     RowBox[{"s", "+", "konb"}], ")"}]}]]}]], "Input",
 CellChangeTimes->{{3.948979812817156*^9, 3.948979872329485*^9}, {
  3.9489799431395607`*^9, 3.948979946864086*^9}, {3.949047924671096*^9, 
