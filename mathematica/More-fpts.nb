Cell[BoxData[
 RowBox[{
  RowBox[{"p2", "[", "c", "]"}], ":=", 
  RowBox[{"InverseLaplaceTransform", "[", 
   RowBox[{
    RowBox[{"P2", "[", "s", "]"}], ",", "s", ",", "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.948979875390658*^9, 3.948979880514743*^9}, {
