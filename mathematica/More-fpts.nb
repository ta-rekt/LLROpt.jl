Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "k0", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"d2p2", " ", "=", " ", 
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"D", "[", 
     RowBox[{
      RowBox[{"Log", "[", 
       RowBox[{"p2", "[", "c", "]"}], "]"}], ",", " ", 
      RowBox[{"{", 
       RowBox[{"c", ",", "2"}], "}"}]}], "]"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", "==", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"c", "*", "kboff"}], "+", "k0"}], ")"}]}], "}"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.952939443855624*^9, 3.9529394775499363`*^9}, {
  3.952939515423085*^9, 3.952939518504662*^9}, {3.95293954925743*^9, 
