             RowBox[{"Log", "[", "fp", "]"}], "-", 
             RowBox[{"Log", "[", "fm", "]"}]}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", "\[Delta]"}], ")"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"N", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"dlog", "^", "2"}], "*", "f0", "*", 
            RowBox[{
             RowBox[{"c0i", "^", "2"}], "/", "\[Tau]PartialEval"}]}], ",", 
           "20"}], "]"}]}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t1i", ",", "0", ",", "\[Infinity]"}], "}"}], ",", 
