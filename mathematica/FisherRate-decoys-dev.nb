      RowBox[{"konb_", "?", "NumericQ"}], ",", 
      RowBox[{"koffu_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "\[Tau]eval", ",", "integral", ",", "A1", ",", "A2", ",", "A3", ",", 
        "B1", ",", "B2", ",", "B3", ",", "C1", ",", "C2", ",", "C3", ",", 
        "C4", ",", "C5", ",", "C6"}], "}"}], ",", "\[IndentingNewLine]", 
