              RowBox[{"c0i", "-", "\[Delta]"}]}]}], "}"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"central", "\[Hyphen]", 
           RowBox[{"difference", " ", "derivative", " ", "of", " ", "log"}], "\[Hyphen]",
            "pdf"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"dlog", "=", 
