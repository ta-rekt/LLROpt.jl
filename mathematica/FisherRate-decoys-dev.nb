      RowBox[{"kboni_", "?", "NumericQ"}], ",", 
      RowBox[{"koffui_", "?", "NumericQ"}], ",", 
      RowBox[{"kuoffi_", "?", "NumericQ"}], ",", 
      RowBox[{"konui_", "?", "NumericQ"}]}], " ", "]"}], ":=", 
    RowBox[{"NIntegrate", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "f0", ",", "fp", ",", "fm", ",", "dlog", ",", "PjointPartEval", ",", 
          "\[Tau]PartialEval"}], "}"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"\[Tau]PartialEval", "=", 
          RowBox[{"\[Tau]fun", "[", 
           RowBox[{
           "c0i", ",", "c2i", ",", "\[Gamma]i", ",", "kboffi", ",", "konbi", ",",
             "kuoni", ",", "kboni", ",", "koffui", ",", "kuoffi", ",", 
            "konui"}], "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"PjointPartEval", "=", 
          RowBox[{"Pjoint", "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"konb", "->", "konbi"}], ",", 
             RowBox[{"kuon", "->", "kuoni"}], ",", " ", 
             RowBox[{"koffu", "->", "koffui"}], ",", 
             RowBox[{"kboff", "->", "kboffi"}], ",", 
             RowBox[{"kbon", "->", "kboni"}], ",", 
             RowBox[{"konu", "->", "konui"}], ",", 
             RowBox[{"kuoff", "->", "kuoffi"}]}], "}"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"f0", "=", 
          RowBox[{"PjointPartEval", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"t1", "->", "t1i"}], ",", 
             RowBox[{"t2", "->", "t2i"}], ",", 
             RowBox[{"c", "->", "c0i"}]}], "}"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"fp", "=", 
          RowBox[{"PjointPartEval", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"t1", "->", "t1i"}], ",", 
             RowBox[{"t2", "->", "t2i"}], ",", 
             RowBox[{"c", "->", 
              RowBox[{"c0i", "+", "\[Delta]"}]}]}], "}"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"fm", "=", 
